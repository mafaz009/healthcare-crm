generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN   // MashHealth platform admin — no doctorId, sees everything
  DOCTOR_ADMIN  // Clinic owner/doctor — has doctorId, manages own tenant
  STAFF         // Receptionist/coordinator — has doctorId, scoped capabilities
}

enum DoctorStatus {
  ACTIVE     // Fully operational
  INACTIVE   // Soft-disabled (not deleted)
  SUSPENDED  // Billing/compliance hold — API key auth also rejected
}

// Future-proofing: plan tier controls feature access (no billing logic yet)
enum PlanTier {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum LeadStatus {
  NEW                // Just entered the system
  CONTACTED          // First contact made
  FOLLOW_UP          // Needs a follow-up call/message
  INTERESTED         // Expressed genuine interest
  APPOINTMENT_BOOKED // Appointment scheduled
  NO_RESPONSE        // Tried but couldn't reach
  NOT_INTERESTED     // Explicitly declined
  CLOSED             // Deal closed / converted to patient
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS  (all roles share this table — role field controls access)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(150)

  // ── Authentication identity ────────────────────────────────────────────────
  // loginId  → PRIMARY login username. Typed into the "Username or Email" field.
  //            Lowercase alphanumeric + . _ -   (3–50 chars, starts/ends alphanumeric)
  //            Examples: admin · dr.manmeet · staff.priya.2
  //            Auto-generated from name on create. Editable by the user.
  loginId  String  @unique @db.VarChar(50)

  // email    → CONTACT address only. Used for notifications and future password-reset.
  //            Still accepted at login for backward compatibility (smart detection).
  //            NOT the primary auth key — loginId is.
  email    String  @unique @db.VarChar(255)

  password String  @db.VarChar(255)
  role     Role    @default(STAFF)
  isActive Boolean @default(true)

  // NULL for SUPER_ADMIN; required for DOCTOR_ADMIN and STAFF
  doctorId Int?
  doctor   Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  // Token version: increment to instantly invalidate all existing JWTs for this user.
  // Use cases: password change, account disable, suspicious activity, forced re-login.
  tokenVersion Int @default(0)

  // Last login tracking for security monitoring and inactive account detection.
  lastLoginAt DateTime?

  // Per-staff permission overrides (null = use STAFF role defaults).
  // Only meaningful for STAFF role. DOCTOR_ADMIN and SUPER_ADMIN ignore this.
  // Shape: {"leads":{"delete":true},"blogs":{"publish":true,"delete":false}}
  // A missing key means "use role default". Explicit false overrides the default.
  permissions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadComments       LeadComment[]
  leadFollowUps      LeadFollowUp[]
  leadStatusChanges  LeadStatusHistory[]
  assignedLeads      Lead[]              @relation("AssignedLeads")
  auditLogs          AuditLog[]

  @@index([doctorId])
  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCTORS  (one row per client — the tenant unit)
// ─────────────────────────────────────────────────────────────────────────────

model Doctor {
  id        Int          @id @default(autoincrement())
  name      String       @db.VarChar(150)
  specialty String       @db.VarChar(150)
  domain    String       @db.VarChar(255) // e.g. "urologybymanmeet.com"
  email     String       @unique @db.VarChar(255)
  phone     String?      @db.VarChar(20)
  status    DoctorStatus @default(ACTIVE)
  logoUrl   String?      @db.VarChar(500)
  address   String?      @db.Text

  // Plan tier — no enforcement logic yet, but used for UI feature gates later
  plan PlanTier @default(BASIC)

  // External website integration key — passed as X-Api-Key header by PHP websites.
  // Rejected if doctor status is SUSPENDED (enforced in apiKeyAuth middleware).
  apiKey String @unique @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  leads          Lead[]
  appointments   Appointment[]
  blogs          Blog[]
  auditLogs      AuditLog[]
  ingestionLogs  IngestionLog[]

  @@map("doctors")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG  (immutable append-only record of sensitive actions)
// ─────────────────────────────────────────────────────────────────────────────
//
// Captures: who did what, to which resource, on which tenant, from which IP.
// Written by the auditLog() middleware applied to sensitive routes.
// SUPER_ADMIN actions are always logged. Useful for forensics and compliance.
//
// action format: "resource.verb" e.g. "lead.delete", "blog.publish", "staff.create"

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   @db.VarChar(100)
  resourceId Int?     // ID of the affected row (lead.id, blog.id, etc.)
  metadata   Json?    // extra context — old status, new status, patient name, etc.
  ipAddress  String?  @db.VarChar(45) // IPv4 or IPv6

  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which tenant's data was affected — NULL for SUPER_ADMIN global actions
  doctorId Int?
  doctor   Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([doctorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEADS
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id           Int        @id @default(autoincrement())
  patientName  String     @db.VarChar(150)
  phone        String     @db.VarChar(20)
  email        String?    @db.VarChar(255)
  city         String?    @db.VarChar(100)
  status       LeadStatus @default(NEW)

  // ── Source & Attribution ──────────────────────────────────────────────────
  // Human-readable source label used in the UI (facebook, google, walk-in…)
  source       String?    @db.VarChar(100)
  campaignName String?    @db.VarChar(200)

  // UTM parameters — auto-populated from landing page URLs or webhook payloads
  utmSource   String? @db.VarChar(255) // utm_source
  utmMedium   String? @db.VarChar(255) // utm_medium
  utmCampaign String? @db.VarChar(255) // utm_campaign
  utmContent  String? @db.VarChar(255) // utm_content
  utmTerm     String? @db.VarChar(255) // utm_term

  // Paid ads metadata (Meta / Google)
  adSet      String? @db.VarChar(200)
  adName     String? @db.VarChar(200)
  landingPage String? @db.VarChar(500)

  // External platform ID — Meta lead_id, Google click ID (gclid), etc.
  externalId String? @db.VarChar(150)

  // ── Follow-up ─────────────────────────────────────────────────────────────
  // Denormalised "next follow-up at" for fast dashboard queries
  followUpAt DateTime?

  // ── Assignment ───────────────────────────────────────────────────────────
  assignedUserId Int?
  assignedUser   User? @relation("AssignedLeads", fields: [assignedUserId], references: [id], onDelete: SetNull)

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments       LeadComment[]
  followUps      LeadFollowUp[]
  statusHistory  LeadStatusHistory[]
  ingestionLogs  IngestionLog[]

  @@index([doctorId])
  @@index([status])
  @@index([doctorId, status])
  @@index([assignedUserId])
  @@index([followUpAt])
  @@index([createdAt])
  @@map("leads")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAD COMMENTS  (free-text notes on a lead — appended to the timeline)
// ─────────────────────────────────────────────────────────────────────────────

model LeadComment {
  id      Int    @id @default(autoincrement())
  comment String @db.Text

  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_comments")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAD FOLLOW-UPS  (scheduled call-back / callback tasks)
// ─────────────────────────────────────────────────────────────────────────────
//
// Each row is one scheduled follow-up task.
// completedAt NULL  → pending / overdue
// completedAt set   → done
// note        → what the staff member should discuss / what was discussed

model LeadFollowUp {
  id          Int       @id @default(autoincrement())
  scheduledAt DateTime              // when to follow up
  completedAt DateTime?             // NULL = pending
  note        String?   @db.Text   // optional instructions / outcome

  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // The staff member who scheduled (or is responsible for) this follow-up
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([userId])
  @@index([scheduledAt])
  @@index([completedAt])
  @@map("lead_follow_ups")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAD STATUS HISTORY  (immutable audit trail of every status transition)
// ─────────────────────────────────────────────────────────────────────────────

model LeadStatusHistory {
  id         Int        @id @default(autoincrement())
  fromStatus LeadStatus?          // NULL on first creation
  toStatus   LeadStatus
  note       String?    @db.VarChar(500)  // optional reason / context

  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  changedById Int
  changedBy   User @relation(fields: [changedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([changedById])
  @@map("lead_status_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// APPOINTMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Appointment {
  id            Int               @id @default(autoincrement())
  patientName   String            @db.VarChar(150)
  phone         String            @db.VarChar(20)
  email         String?           @db.VarChar(255)
  issue         String?           @db.Text
  preferredDate DateTime          @db.Date
  preferredTime String?           @db.VarChar(10) // "10:30 AM"
  status        AppointmentStatus @default(PENDING)
  notes         String?           @db.Text
  source        String?           @db.VarChar(100) // website, phone, walk-in, api

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
  @@index([status])
  @@index([preferredDate])
  @@index([doctorId, status])
  @@map("appointments")
}

// ─────────────────────────────────────────────────────────────────────────────
// BLOGS
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// INGESTION LOG  (append-only record of every inbound lead submission)
// ─────────────────────────────────────────────────────────────────────────────
//
// event values:
//   'lead_created'       – lead was successfully created
//   'duplicate_skipped'  – same phone+doctorId within 30 days — silently ignored
//   'validation_failed'  – payload missing required fields
//   'spam_blocked'       – (future) rate-limit or spam-filter rejection
//
// source values:
//   'meta', 'google', 'generic', 'site-lead', 'api'

model IngestionLog {
  id         Int      @id @default(autoincrement())
  source     String   @db.VarChar(50)   // ingestion channel
  event      String   @db.VarChar(50)   // what happened
  doctorId   Int
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  leadId     Int?                        // NULL if lead was not created
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  phone      String?  @db.VarChar(30)   // normalized digits-only phone
  externalId String?  @db.VarChar(150)  // Meta lead_id, gclid, etc.
  payload    Json?                       // raw inbound payload for debugging
  ipAddress  String?  @db.VarChar(45)
  note       String?  @db.VarChar(500)  // error message or context

  createdAt  DateTime @default(now())

  @@index([doctorId])
  @@index([leadId])
  @@index([event])
  @@index([source])
  @@index([createdAt])
  @@map("ingestion_logs")
}

model Blog {
  id    Int    @id @default(autoincrement())
  title String @db.VarChar(300)

  // Slug is unique PER doctor — two doctors can both have /blog/knee-pain
  slug String @db.VarChar(350)

  featuredImage   String? @db.VarChar(500)
  content         String  @db.LongText
  seoTitle        String? @db.VarChar(70)
  metaDescription String? @db.VarChar(160)
  keywords        String? @db.VarChar(500)

  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, doctorId])
  @@index([doctorId])
  @@index([status])
  @@index([doctorId, status])
  @@map("blogs")
}
