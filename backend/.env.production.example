# ── PRODUCTION .env for Hostinger ──
# Copy this to .env on the server and fill in real values
# NEVER commit the real .env file to GitHub

NODE_ENV=production
PORT=5000

# Hostinger MySQL (get these from hPanel → Databases → MySQL)
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# Generate a strong secret: https://generate-secret.vercel.app/64
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Your actual domains (comma separated)
ALLOWED_ORIGINS=https://crm.YOURDOMAIN.com,https://YOURDOMAIN.com

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Your API subdomain — used in blog SEO canonical URLs
API_BASE_URL=https://api.YOURDOMAIN.com

# A strong random string (keep secret)
WEBHOOK_SECRET=REPLACE_WITH_STRONG_SECRET
